/* Windows resource script for pagemade.
 *
 * Resource ID 1: Explorer, the taskbar shortcut and Alt-Tab use the icon
 * with the numerically lowest ID as the application icon.
 * GLFW_ICON: the window class icon. GLFW loads this name itself.
 * Both point at pagemade.ico, built from pagemade-logo.png by
 * resources/make_pagemade_icon.py. Replace the png and rerun that script.
 * The path is relative to this .rc file, which is where rc.exe looks first. */

1 ICON "pagemade.ico"
GLFW_ICON ICON "pagemade.ico"
